# PostgreSQL bağlantı dizesi — docker-compose varsayılan değerleri
DATABASE_URL=postgresql://elbis:elbis_pass@postgres:5432/elbis_db
UVICORN_WORKERS=1

# ── ACLED (isteğe bağlı) ─────────────────────────────────────────────────────
# Ücretsiz kayıt: https://acleddata.com/register
ACLED_KEY=
ACLED_EMAIL=

# ── Telegram (isteğe bağlı) ──────────────────────────────────────────────────
# 1. https://my.telegram.org → API development tools
# 2. Uygulama oluştur → api_id + api_hash al
# 3. Aşağıya yapıştır, ardından oturum oluştur:
#    docker exec -it elbis-backend-1 python /app/telegram_auth.py
TG_API_ID=
TG_API_HASH=
